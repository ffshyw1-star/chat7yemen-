rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function existingData() {
      return resource.data;
    }

    function incomingData() {
      return request.resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Helper to check Primary Owner protection
    function isPrimaryOwnerId(userId) {
      return userId == 'user-owner';
    }

    function isPrimaryOwnerDoc(data) {
      return data != null && (
        data.get('id', '') == 'user-owner' ||
        data.get('isPrimaryOwner', false) == true ||
        data.get('is_primary_owner', false) == true
      );
    }

    // Test connection doc
    match /test/{testId} {
      allow read, write: if true;
    }

    // User accounts and profiles with Primary Owner Deletion Protection
    match /users/{userId} {
      allow read: if true;
      allow create, update: if true;
      
      // Account deletion: Primary Owner account CAN NEVER be deleted!
      allow delete: if !isPrimaryOwnerId(userId) && !isPrimaryOwnerDoc(existingData());

      // Sub-collections under users (e.g., membershipHistory)
      match /{subCollection=**} {
        allow read, write: if true;
      }
    }

    // Realtime Presence sessions matching presence/{userId} and subcollections
    match /presence/{userId} {
      allow read, write: if true;

      match /{subCollection=**} {
        allow read, write: if true;
      }
    }

    // Public room messages
    match /messages/{messageId} {
      allow read, write: if true;
    }

    // Private messages
    match /private_messages/{messageId} {
      allow read, write: if true;
    }

    // Chat Rooms
    match /rooms/{roomId} {
      allow read, write: if true;
    }

    // Site Settings and Configuration (Owner Dashboard)
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Admin & Dispute Audit Logs System
    match /audit_logs/{logId} {
      allow read, write: if true;
    }

    // Notifications
    match /notifications/{notifId} {
      allow read, write: if true;
    }

    // Wall Posts & News
    match /wall_posts/{postId} {
      allow read, write: if true;
    }
    match /news/{newsId} {
      allow read, write: if true;
    }

    // Custom Emojis
    match /custom_emojis/{emojiId} {
      allow read, write: if true;
    }

    // Fallback match to ensure no operational disruption
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
