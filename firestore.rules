rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function existingData() {
      return resource.data;
    }

    function incomingData() {
      return request.resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Helper to get user profile document
    function getUserData(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }

    // Checks that the user has a valid active or permanent membership
    function isMembershipValid(userData) {
      return userData != null && (
        userData.role == 'owner' ||
        (userData.membership != null && (
          userData.membership.permanent == true ||
          userData.membership.status == 'active'
        ))
      );
    }

    // Resolves effective rank from membership object rather than raw rank
    function getEffectiveRank(userData) {
      return userData == null ? 'visitor' :
             userData.role == 'owner' ? 'owner' :
             (userData.membership != null && (userData.membership.permanent == true || userData.membership.status == 'active'))
             ? (userData.membership.rank != null ? userData.membership.rank : userData.role)
             : (userData.role == 'visitor' ? 'visitor' : 'member');
    }

    // Verify administrative capability using membership object validation
    function hasActiveAdminMembership(userId, allowedRanks) {
      let u = getUserData(userId);
      return u != null && isMembershipValid(u) && getEffectiveRank(u) in allowedRanks;
    }

    // Check if user is Primary Site Owner (Sovereign Owner)
    function isPrimaryOwnerId(userId) {
      return userId == 'user-owner';
    }

    function isPrimaryOwnerDoc(data) {
      return data != null && (
        data.id == 'user-owner' ||
        data.isPrimaryOwner == true ||
        data.is_primary_owner == true ||
        data.email == 'alzymasd9@gmail.com' ||
        (data.role == 'owner' && (data.username == 'Owner' || data.username == 'صاحب الموقع'))
      );
    }


    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Test connection doc
    match /test/{testId} {
      allow read, write: if true;
    }

    // User accounts and profiles with Absolute Primary Owner Protection
    match /users/{userId} {
      allow read: if true;

      // Account creation: Cannot spoof primary owner id without sovereign owner role
      allow create: if !isPrimaryOwnerId(userId) || incomingData().role == 'owner';

      // Account update:
      // If updating Primary Owner account:
      // Role MUST remain 'owner' (Demotion to Admin, Management, Member or Visitor is STRICTLY DENIED).
      allow update: if (!isPrimaryOwnerId(userId) && !isPrimaryOwnerDoc(existingData())) || (
        incomingData().role == 'owner'
      );

      // Account deletion: Primary Owner account CAN NEVER be deleted!
      allow delete: if !isPrimaryOwnerId(userId) && !isPrimaryOwnerDoc(existingData());

      // Sub-collection for audit of membership changes
      match /membershipHistory/{historyId} {
        allow read: if true;
        allow create: if true;
        allow update, delete: if false;
      }
    }


    // Realtime Presence sessions matching presence/{userId} and subcollections
    match /presence/{userId} {
      allow read: if true;
      allow write: if true;

      match /connections/{connectionId} {
        allow read: if true;
        allow write: if true;
      }
    }

    // Public room messages
    match /messages/{messageId} {
      allow read, write: if true;
    }

    // Private messages
    match /private_messages/{messageId} {
      allow read, write: if true;
    }

    // Chat Rooms
    match /rooms/{roomId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Site Settings and Configuration (Owner Dashboard)
    match /settings/{settingId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }
  }
}


